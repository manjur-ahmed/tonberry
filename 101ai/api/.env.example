PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tonberry
DATABASE_PASSWORD=tonberry
DATABASE_NAME=tonberry_101ai

FRONTEND_URL=http://localhost:5174
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
JWT_SECRET=dev-only-change-me

# Phase 2 — Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Steps Planner (see StepsPlannerService/GoogleMapsClient) — the SAME key
# web/.env's VITE_GOOGLE_MAPS_BROWSER_API_KEY exposes to the browser: one
# shared key used both server-side (Routes API, Places API (New)) and
# client-side (Maps JavaScript API, Maps Static API). Since it
# can't be HTTP-referrer-restricted (that would block the server-side
# calls), restrict it by API instead, in Google Cloud Console, to just
# those four APIs — nothing broader, since this key is exposed in the
# browser's page source.
GOOGLE_API_KEY=

# Phase 3 — AI provider
OPENAI_API_KEY=

# The one email allowed to hit /admin/usage/* (see AdminGuard)
ADMIN_EMAIL=

# Chat/note attachments (see UploadsService). S3_ENDPOINT is local-dev only —
# points at the root docker-compose.yml's minio service; leave it unset in
# prod so the SDK talks to real S3 using Lambda's IAM role instead of a
# static key pair. S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are only read when
# S3_ENDPOINT is set (MinIO's root user/password).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tonberry-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tonberry
S3_SECRET_ACCESS_KEY=tonberry123

# News's "further reading" article links (see NewsClient) — NewsData.io's
# free tier (200 requests/day, commercial use allowed). Best-effort: if
# this is unset or the request fails, News still works, just with no real
# article links attached (see NewsClient.search's fallback).
NEWSDATA_API_KEY=
