# Optional — defaults to http://<current-hostname>:3001 when unset (see
# lib/api.ts), which already works for both localhost and phone/LAN testing
# without editing this. Only set it to point at a different API (e.g. prod)
# explicitly.
VITE_API_URL=

# Steps Planner's maps (see steps-planner/RouteMap.tsx — the live
# interactive map — and steps-planner/ItemView.tsx — a static thumbnail for
# the saved-item tile) — this is intentionally the SAME value as the
# backend's GOOGLE_API_KEY (api/.env), not a separate key: the user chose
# one shared key over the originally-planned two-key design. Since a
# browser-exposed key can't be protected by keeping it secret, and this one
# can't be HTTP-referrer-restricted either (that would break the backend's
# server-side Routes/Places calls), its safety net is API restriction in
# Google Cloud Console instead — locked to just Maps JavaScript API + Maps
# Static API + Routes API + Places API (New), nothing broader.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# MS Clarity session analytics (see lib/analytics.ts) — safe to set even in
# local dev: initAnalytics() only actually loads the Clarity script when
# window.location.hostname is the real prod domain (101ai.tonberry.co.uk),
# never localhost or any other host, so local/preview browsing never
# reports session data.
VITE_CLARITY_PROJECT_ID=

# Grafana Faro (Frontend Observability) — see lib/faro.ts. Same
# real-prod-domain-only gate as Clarity above, for the same reason. From
# Grafana Cloud > Observability > Frontend > this app > Configuration.
VITE_FARO_COLLECTOR_URL=
